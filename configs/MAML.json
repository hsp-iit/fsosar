{
    "backbone": "resnet18",
    "hidden_size": 512,
    "num_layers_temporal": 2,
    "num_heads": 8,
    "intermediate_size": 2048,
    "inner_lr": 0.01,
    "inner_steps": 5,
    "first_order": false,
    "use_l2_loss": true,
    "alpha": 0.1,
    "lr": 1e-4,
    "query_per_class": 1,
    "optimize_every": 1,
    "maximum_queries": 5,
    "num_workers": 4,
    "ddp": false,
    "dp": true,
    "shot": 5
}
