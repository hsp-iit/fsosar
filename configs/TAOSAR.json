{
    "backbone": "resnet50",
    "hidden_size": 512,
    "num_layers_temporal": 1,
    "num_heads": 4,
    "intermediate_size": 1024,
    "use_l2_loss": true,
    "alpha": 0.1,
    "lr": 1e-5,
    "temperature": 10.0,
    "consistency_weight": 0.1,
    "uncertainty_weight": 0.1,
    "motion_threshold": 0.1,
    "query_per_class": 1,
    "optimize_every": 1,
    "maximum_queries": 3,
    "num_workers": 4,
    "ddp": false,
    "dp": true,
    "shot": 5
}
