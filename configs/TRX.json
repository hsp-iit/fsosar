{
    "backbone": "resnet18",
    "freeze_backbone": true,
    "trans_linear_out_dim": 1152,
    "temp_set": [2],
    "trans_dropout": 0.1,
    "use_l2_loss": false,
    "dp": false,
    "save_features": false,
    "ddp": false,
    "shot": 5,
    "lr": 0.001,
    "optimizer": "sgd",
    "scheduler": "multistep",
    "momentum": 0.9,
    "weight_decay": 1e-4,
    "scheduler_milestones": [1000000],
    "scheduler_gamma": 0.1,
    "disc_weight": 10,
    "lr_1_shot": 0.001,
    "lr_5_shot": 0.001,
    "query_per_class": 1,
    "optimize_every": 16,
    "maximum_queries": 1000
}